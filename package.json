{
  "name": "mcp-enterprise-microservice",
  "version": "1.0.0",
  "type": "module",
  "description": "Enterprise Microservice with MCP Integration",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write \"src/**/*.js\"",
    "docker:build": "docker build -t mcp-service .",
    "docker:run": "docker run -p 3000:3000 mcp-service"
  },
  "keywords": [
    "microservice",
    "mcp",
    "ai",
    "enterprise",
    "nodejs"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.56.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^7.2.0",
    "openai": "^4.87.3",
    "zod": "^3.24.2"
  }
}
